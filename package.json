{
	"name": "zexestock",
	"version": "1.0.0",
	"description": "ZexeStock — admin frontend build",
	"private": true,
	"scripts": {
		"postinstall": "patch-package",
		"build": "webpack --mode=production --config webpack.config.js",
		"start": "webpack --mode=development --watch --config webpack.config.js",
		"check-engines": "wp-scripts check-engines",
		"lint:js": "wp-scripts lint-js admin/src",
		"lint:css": "wp-scripts lint-style \"admin/src/**/*.{css,scss}\"",
		"ts:check": "tsc --noEmit",
		"test:js": "wp-scripts test-unit-js",
		"test:js:watch": "wp-scripts test-unit-js --watch",
		"test:php": "composer test",
		"test": "npm run test:js && npm run test:php",
		"version": "node scripts/bump-version.js"
	},
	"dependencies": {
		"@radix-ui/react-checkbox": "^1.3.3",
		"@radix-ui/react-dialog": "^1.1.2",
		"@radix-ui/react-dropdown-menu": "^2.1.2",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-select": "^2.1.2",
		"@radix-ui/react-slot": "^1.1.0",
		"@radix-ui/react-switch": "^1.1.1",
		"@radix-ui/react-tabs": "^1.1.1",
		"@radix-ui/react-tooltip": "^1.1.3",
		"@tanstack/react-query": "^5.62.0",
		"@tanstack/react-table": "^8.20.6",
		"@wordpress/date": "^4.58.0",
		"chart.js": "^4.5.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^3.6.0",
		"jspdf": "^4.2.1",
		"jspdf-autotable": "^5.0.7",
		"lucide-react": "^0.460.0",
		"react-chartjs-2": "^5.3.1",
		"react-day-picker": "^8.10.1",
		"sonner": "^1.7.1",
		"tailwind-merge": "^2.5.4",
		"xlsx": "^0.18.5"
	},
	"devDependencies": {
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.5.2",
		"@types/react": "^18.3.28",
		"@types/react-dom": "^18.3.7",
		"@types/wordpress__block-editor": "^11.5.14",
		"@types/wordpress__components": "^23.0.12",
		"@types/wordpress__data": "^6.0.2",
		"@wordpress/scripts": "^30.0.0",
		"autoprefixer": "^10.4.19",
		"msw": "^2.7.0",
		"patch-package": "^8.0.1",
		"postcss": "^8.4.38",
		"tailwindcss": "^3.4.4",
		"typescript": "^5.5.2"
	}
}
